# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/
**/.claude/

# Python bytecode cache from post code/notebooks
__pycache__/
*.pyc

# Raw intermediate NetCDF dumps — large, and superseded by the derived CSVs
# that posts actually reference
**/raw_netcdf/

# Large intermediate weather merge (300MB+, over GitHub's file size limit) —
# superseded by the derived PV generation CSV that posts actually reference
**/WeatherData_Acquisition/ERA5_DK1_Merged.csv

# Bundled third-party GLPK solver package — see each post's Installation_Guide.md
# for the SourceForge download link instead of committing the package itself
**/winglpk-4.65/
**/winglpk-4.65.zip
